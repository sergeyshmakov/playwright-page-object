{
	"mcpServers": {
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp@latest"],
			"env": {
				"CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
			}
		},
		"playwright-page-object": {
			"command": "node",
			"args": ["run/mcp-server.mjs", "mcp", "--project-root", "example"]
		}
	}
}
