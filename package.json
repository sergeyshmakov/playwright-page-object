{
	"name": "playwright-page-object",
	"version": "2.0.3",
	"description": "Typed, decorator-driven Page Object Model for Playwright. Reusable, lazy locator chains in plain TypeScript classes.",
	"license": "MIT",
	"type": "commonjs",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./mcp": {
			"import": {
				"types": "./dist/mcp.d.mts",
				"default": "./dist/mcp.mjs"
			},
			"require": {
				"types": "./dist/mcp.d.ts",
				"default": "./dist/mcp.js"
			}
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"mcp": [
				"./dist/mcp.d.ts"
			]
		}
	},
	"bin": {
		"playwright-page-object": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prebuild": "node ./run/clean-dist.mjs",
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome check src tsup.config.ts",
		"lint:fix": "biome check --write src tsup.config.ts",
		"lint:pkg": "publint --strict && attw --pack .",
		"pack:example": "node ./run/pack-example-package.mjs",
		"prepare": "husky",
		"prepublishOnly": "node ./run/verify-dist.mjs",
		"typecheck": "tsc --noEmit",
		"typecheck:example": "cd example && tsc --noEmit",
		"typecheck:all": "npm run typecheck && npm run typecheck:example",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cli": "node ./run/smoke-cli.mjs",
		"example:install": "cd example && npm install --force ../playwright-page-object.tgz",
		"example:browsers": "cd example && npx playwright install --with-deps chromium",
		"example:e2e": "cd example && npm run test:e2e",
		"test:example": "npm run pack:example && npm run example:install && npm run test:cli && npm run example:browsers && npm run example:e2e"
	},
	"keywords": [
		"playwright",
		"page-object",
		"page-object-model",
		"pom",
		"typescript",
		"decorators",
		"selectors",
		"locators",
		"e2e",
		"e2e-testing",
		"test-automation",
		"testing",
		"qa",
		"mcp",
		"model-context-protocol",
		"ai-agents"
	],
	"author": {
		"name": "Sergei Shmakov",
		"url": "https://github.com/sergeyshmakov"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sergeyshmakov/playwright-page-object.git"
	},
	"bugs": {
		"url": "https://github.com/sergeyshmakov/playwright-page-object/issues"
	},
	"homepage": "https://pom.shmakov.tools/",
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			[
				"@semantic-release/changelog",
				{
					"changelogFile": "CHANGELOG.md"
				}
			],
			"@semantic-release/npm",
			[
				"@semantic-release/git",
				{
					"assets": [
						"package.json",
						"package-lock.json",
						"CHANGELOG.md"
					],
					"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
				}
			],
			"@semantic-release/github"
		]
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@babel/plugin-proposal-decorators": "^7.29.7",
		"@biomejs/biome": "^2.4.15",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@modelcontextprotocol/client": "^2.0.0",
		"@playwright/test": "^1.60.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^22.19.19",
		"@types/picomatch": "^4.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"publint": "^0.3.23",
		"semantic-release": "^25.0.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.35.0",
		"typescript": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	},
	"volta": {
		"node": "24.14.0"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"commander": "^14.0.3",
		"picomatch": "^4.0.5",
		"resolve.exports": "^2.0.3",
		"ts-morph": "^28.0.0",
		"zod": "^4.2.0"
	}
}
